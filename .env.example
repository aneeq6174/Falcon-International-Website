# Contact form — SMTP
#
# The site authenticates as a real mailbox and sends each enquiry to
# business@falconinternational.net.pk. No third-party form service holds the
# leads. Set these in Vercel: Project > Settings > Environment Variables.
#
# LIVE SETUP (as configured): Zoho Mail.
#   SMTP_PASS is a Zoho APP PASSWORD, not the account login password —
#   Zoho refuses SMTP with the login password when 2FA is on. Generate one at
#   Zoho > My Account > Security > App Passwords.
#   SMTP_HOST follows the data centre you log in to: mail.zoho.com ->
#   smtp.zoho.com, mail.zoho.eu -> smtp.zoho.eu, mail.zoho.in -> smtp.zoho.in.
#
# NEVER commit real values. `.env` is gitignored; this file is the template.

SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=business@falconinternational.net.pk
SMTP_PASS=

# Where enquiries are delivered. Optional — defaults to the first address in
# content/site.ts. Set it when the sending mailbox is NOT the receiving one
# (e.g. a relay such as Brevo, where SMTP_USER is the relay login).
# CONTACT_TO=business@falconinternational.net.pk

# Set to 1 ONLY for a mail server presenting a certificate for the hosting box
# rather than the mail domain — common on shared cPanel, never needed on Zoho.
# Keeps the connection encrypted but stops verifying who is on the other end.
# SMTP_INSECURE_TLS=1
