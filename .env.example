# Contact form — SMTP for business@falconinternational.net.pk
#
# These are the credentials for the company's OWN mailbox. No third-party form
# service is involved: the site authenticates as that mailbox and sends the
# enquiry to it. Get them from whoever hosts the email (cPanel > Email Accounts >
# Connect Devices, Google Workspace, or Microsoft 365).
#
# Set these in Vercel: Project > Settings > Environment Variables.
# NEVER commit real values — this file is the template only.

SMTP_HOST=mail.falconinternational.net.pk
SMTP_PORT=587
SMTP_USER=business@falconinternational.net.pk
SMTP_PASS=

# Optional. Defaults to the first address in content/site.ts.
# CONTACT_TO=business@falconinternational.net.pk
